{
    // Interpretador do projeto: venv fora do OneDrive (ver README).
    "python.defaultInterpreterPath": "~/.venvs/projeto-sp-data/bin/python",
    // Ativa o venv sozinho em cada terminal novo do VS Code.
    "python.terminal.activateEnvironment": true,
    // Lê o .env do projeto ao rodar/depurar scripts Python.
    "python.envFile": "${workspaceFolder}/.env",
    // Não mostrar lixo gerado pelo Python na árvore de arquivos.
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    // Python: o Ruff formata e organiza os imports ao salvar.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    // SQL: usa o SQLFluff do venv do projeto (mesma versão do pre-commit).
    "sqlfluff.executablePath": "~/.venvs/projeto-sp-data/bin/sqlfluff",
    "python.terminal.useEnvFile": true
}
